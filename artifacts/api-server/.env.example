# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capef

# Clerk Authentication Configuration
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Frontend CORS Configuration (Required for non-localhost/Vercel deployments)
# FRONTEND_URL: Explicitly allows a single frontend URL
FRONTEND_URL=https://capef-frontend.onrender.com

# FRONTEND_URLS: Allows a comma-separated list of multiple frontend URLs
FRONTEND_URLS=https://capef-frontend.onrender.com,https://preview-frontend.onrender.com
